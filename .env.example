# ---------------------------------------------------------------------------
# CasePilot configuration. Copy to `.env` and fill in the blanks.
# All variables are validated at startup by src/server/config/env.ts.
# ---------------------------------------------------------------------------

# Postgres 17 + pgvector (see docker-compose.yml; host port 5433)
DATABASE_URL=postgres://casepilot:casepilot@localhost:5433/casepilot
# Used by integration tests and the eval runner (never your dev data)
TEST_DATABASE_URL=postgres://casepilot:casepilot@localhost:5433/casepilot_test

# better-auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Language model (answer generation + risk analysis) ---------------------
# deepseek | anthropic | openai
LLM_PROVIDER=deepseek
# Leave blank for the provider default (deepseek: deepseek-v4-pro; anthropic: claude-opus-5-5).
LLM_MODEL=
# Model for follow-up-question rewriting (deepseek default: deepseek-flash)
LLM_UTILITY_MODEL=
# low | medium | high | xhigh | max  (DeepSeek maps this to reasoningEffort low | high | max)
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings --------------------------------------------------------------
# DeepSeek has no embeddings API, so indexing needs a separate embedding provider.
# openai     -> AI SDK OpenAI embeddings (requires OPENAI_API_KEY)
# local-hash -> deterministic lexical hashing, for tests/offline dev ONLY (not semantic; refused in production)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column in the migration (1536). Changing it requires a migration + re-index.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# --- Storage -------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=25

# --- Chunking / retrieval (token counts are approximate: ~4 chars per token) ----
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=6000
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.2

# --- Background jobs -----------------------------------------------------------
# true: the Next.js server also runs the job worker (convenient for dev).
# false: run `npm run worker` as a separate process (recommended in production).
WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3

LOG_LEVEL=info
